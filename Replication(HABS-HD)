library(dplyr)
library(ggplot2)

auc_plot_df <- auc_table_adj %>%
  mutate(
    Model = as.character(Model)
  ) %>%
  mutate(
    model_label = case_when(
      Model == "Combined model" ~ "Combined Model",
      Model == "log(p-tau217) + covariates" ~ "P-tau217",
      Model == "log(p-tau217/Aβ42) + covariates" ~ "P-tau217/Aβ42",
      Model == "log(p-tau181/Aβ42) + covariates" ~ "P-tau181/Aβ42",
      Model == "log(Aβ42/40) + covariates" ~ "Aβ42/40",
      Model == "log(p-tau181) + covariates" ~ "P-tau181",
      Model == "log(Aβ42) + covariates" ~ "Aβ42",
      TRUE ~ Model
    ),
    group_type = ifelse(Model == "Combined model",
                        "Combined Model",
                        "Biomarker + covariates"),
    auc_text = sprintf("%.3f (%.2f - %.2f)", AUC, CI_low, CI_high)
  ) %>%
  arrange(desc(AUC)) %>%
  mutate(
    model_label = factor(model_label, levels = rev(unique(model_label)))
  )

cols_auc <- c(
  "Combined Model" = "#E67E22",
  "Biomarker + covariates" = "#2E78B7"
)

p_auc_forest <- ggplot(
  auc_plot_df,
  aes(x = AUC, y = model_label, color = group_type)
) +
  geom_errorbarh(
    aes(xmin = CI_low, xmax = CI_high),
    height = 0.12,
    linewidth = 2
  ) +
  geom_point(size = 6) +
  
  # 右侧数值列：放到框外
  geom_text(
    data = auc_plot_df,
    aes(x = 1.115, y = model_label, label = auc_text),
    inherit.aes = FALSE,
    color = "black",
    hjust = 0,
