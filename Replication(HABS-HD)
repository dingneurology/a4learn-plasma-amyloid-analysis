  theme(
    panel.grid.major = element_line(color = "#D9D9D9", linewidth = 1.4),
    panel.grid.minor = element_line(color = "#ECECEC", linewidth = 0.8),
    panel.border = element_rect(color = "#2B1B17", linewidth = 2.2, fill = NA),
    axis.title.x = element_text(face = "bold", size = 26, family = "serif", color = "black"),
    axis.title.y = element_text(face = "bold", size = 26, family = "serif", color = "black"),
    axis.text.x = element_text(size = 20, color = "black", family = "serif"),
    axis.text.y = element_text(size = 20, color = "black", family = "serif", face = "bold"),
    legend.position = c(0.66, 0.08),
    legend.justification = c(0, 0),
