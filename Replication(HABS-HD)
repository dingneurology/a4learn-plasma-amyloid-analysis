#========================================
# 15. ROC analysis for HABS-HD
#   outcome = amyloid_status
#========================================

library(pROC)

roc_model_specs <- list(
  "Combined model" =
    amyloid_status ~ log_ptau217 + log_ptau181 + log_abeta42 + Age + sex + apoe4_status,
  
  "log(Aβ42/40) + covariates" =
    amyloid_status ~ log_ratio_abeta42_40 + Age + sex + apoe4_status,
  
  "log(Aβ42) + covariates" =
    amyloid_status ~ log_abeta42 + Age + sex + apoe4_status,
  
  "log(p-tau217) + covariates" =
    amyloid_status ~ log_ptau217 + Age + sex + apoe4_status,
  
  "log(p-tau217/Aβ42) + covariates" =
    amyloid_status ~ log_ratio_ptau217_ab42 + Age + sex + apoe4_status,
  
  "log(p-tau181) + covariates" =
    amyloid_status ~ log_ptau181 + Age + sex + apoe4_status,
  
  "log(p-tau181/Aβ42) + covariates" =
    amyloid_status ~ log_ratio_ptau181_ab42 + Age + sex + apoe4_status
)

roc_df_adj <- list()
auc_table_adj <- list()
roc_obj_list <- list()

for (nm in names(roc_model_specs)) {
  fit <- glm(roc_model_specs[[nm]], data = analysis_dat, family = binomial())
  pred <- predict(fit, type = "response")
  roc_obj <- roc(analysis_dat$amyloid_status, pred, quiet = TRUE)
  ci_obj <- ci.auc(roc_obj)
  
  roc_obj_list[[nm]] <- roc_obj
  
  roc_df_adj[[nm]] <- data.frame(
    specificity = roc_obj$specificities,
    sensitivity = roc_obj$sensitivities,
    feature = nm
  )
  
  auc_table_adj[[nm]] <- data.frame(
    Model = nm,
    AUC = as.numeric(auc(roc_obj)),
    CI_low = as.numeric(ci_obj[1]),
    CI_high = as.numeric(ci_obj[3])
  )
}

roc_df_adj <- bind_rows(roc_df_adj)
auc_table_adj <- bind_rows(auc_table_adj)

write_csv(auc_table_adj, "HABS_HD_ROC_AUC_results.csv")

