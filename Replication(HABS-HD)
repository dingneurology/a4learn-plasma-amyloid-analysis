    family = "serif"
  ) +
  
  # 右侧标题：也放到框外
  annotate(
    "text",
    x = 1.115,
    y = length(levels(auc_plot_df$model_label)) + 0.7,
    label = "AUC(95%CI)",
    hjust = 0,
    size = 9,
    fontface = "bold",
    family = "serif"
  ) +
  
  scale_color_manual(values = cols_auc) +
  scale_x_continuous(
